{
  "expo": {
    "name": "Моя аптечка",
    "slug": "pharmacy",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "pharmacy",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.calculatorplatform.pharmacy"
    },
    "android": {
      "package": "com.calculatorplatform.pharmacy",
      "versionCode": 1,
      "adaptiveIcon": {
        "backgroundColor": "#E8F6F3",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-sqlite",
      "expo-dev-client",
      [
        "expo-image-picker",
        {
          "photosPermission": "Приложению нужен доступ к фото, чтобы сохранить изображение лекарства."
        }
      ],
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#E8F6F3",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 120
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "appName": "Моя аптечка",
      "analytics": {
        "provider": "noop",
        "appMetricaApiKey": null
      },
      "ads": {
        "provider": "noop",
        "enabled": false,
        "bannerUnitId": null,
        "interstitialUnitId": null
      }
    }
  }
}
